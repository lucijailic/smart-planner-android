<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvEventsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="36dp"
        android:text="Events"
        android:textColor="@color/sp_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvEventsSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:text="Keep track of what’s coming up."
        android:textColor="@color/sp_text_secondary"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEventsTitle" />

    <!-- ===================================================== -->
    <!-- WEEK CALENDAR -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEventCalendar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="@color/sp_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEventsSubtitle"
        app:strokeColor="@color/sp_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <!-- MONTH + CONTROLS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEventCalendarMonth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnEventCalendarPicker"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Choose date"
                    android:padding="9dp"
                    android:src="@drawable/ic_task_calendar_small"
                    app:tint="@color/sp_teal_dark" />

                <TextView
                    android:id="@+id/btnPreviousEventWeek"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/btnNextEventWeek"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="28sp" />

            </LinearLayout>

            <!-- DYNAMIC WEEK DAYS -->

            <LinearLayout
                android:id="@+id/layoutEventWeekDays"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- SELECTED DATE + VIEW ALL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSelectedEventDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/sp_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvViewAllEvents"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:text="View all"
                    android:textColor="@color/sp_teal_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ===================================================== -->
    <!-- SEARCH -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutEventSearch"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_task_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardEventCalendar">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Search"
            android:src="@drawable/ic_task_search"
            app:tint="@color/sp_text_secondary" />

        <EditText
            android:id="@+id/etEventSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search events..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="@color/sp_text_primary"
            android:textColorHint="@color/sp_text_hint"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- QUICK FILTERS -->
    <!-- ===================================================== -->

    <HorizontalScrollView
        android:id="@+id/eventFilterScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutEventSearch">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipEventAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_task_filter_chip_selected"
                android:gravity="center"
                android:minWidth="52dp"
                android:text="All"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipEventToday"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_task_filter_chip"
                android:gravity="center"
                android:minWidth="64dp"
                android:text="Today"
                android:textColor="@color/sp_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipEventUpcoming"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_task_filter_chip"
                android:gravity="center"
                android:minWidth="80dp"
                android:text="Upcoming"
                android:textColor="@color/sp_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipEventOngoing"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_task_filter_chip"
                android:gravity="center"
                android:minWidth="75dp"
                android:text="Ongoing"
                android:textColor="@color/sp_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipEventPast"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_task_filter_chip"
                android:gravity="center"
                android:minWidth="56dp"
                android:text="Past"
                android:textColor="@color/sp_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- ===================================================== -->
    <!-- FILTER + SORT -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutEventControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/eventFilterScroll">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEventFilters"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:text="Filters"
            android:textAllCaps="false"
            android:textColor="@color/sp_teal_dark"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_task_filter"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@color/sp_teal_dark"
            app:strokeColor="@color/sp_teal_dark"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSortEvents"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:text="Sort"
            android:textAllCaps="false"
            android:textColor="@color/sp_teal_dark"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_task_sort"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@color/sp_teal_dark"
            app:strokeColor="@color/sp_teal_dark"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- EVENT LIST -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEvents"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutEventControls" />

    <!-- ===================================================== -->
    <!-- LOADING -->
    <!-- ===================================================== -->

    <ProgressBar
        android:id="@+id/progressEvents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/sp_teal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutEventControls" />

    <!-- ===================================================== -->
    <!-- EMPTY -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutEmptyEvents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutEventControls">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:alpha="0.55"
            android:contentDescription="No events"
            android:src="@drawable/ic_nav_events"
            app:tint="@color/sp_teal_dark" />

        <TextView
            android:id="@+id/tvEmptyEventsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="No matching events"
            android:textColor="@color/sp_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyEventsMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Try changing your search or filters."
            android:textColor="@color/sp_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- ERROR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutErrorEvents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutEventControls">

        <TextView
            android:id="@+id/tvEventsError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/sp_text_primary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryEvents"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:text="Try Again"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/sp_teal"
            app:cornerRadius="14dp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- FAB -->
    <!-- ===================================================== -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddEvent"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="Add event"
        android:src="@drawable/ic_task_add"
        app:backgroundTint="@color/sp_teal"
        app:borderWidth="0dp"
        app:elevation="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="24dp"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>