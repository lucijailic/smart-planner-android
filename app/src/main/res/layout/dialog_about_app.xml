<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="24dp"
    android:paddingEnd="26dp"
    android:paddingBottom="22dp">

    <!-- LOGO -->

    <ImageView
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/smart_planner_logo" />

    <!-- APP NAME -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-rounded"
        android:text="@string/about_dialog_title"
        android:textColor="@color/sp_text_primary"
        android:textSize="21sp"
        android:textStyle="bold" />

    <!-- TAGLINE -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-rounded"
        android:gravity="center"
        android:text="@string/splash_tagline"
        android:textColor="@color/sp_teal_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- DESCRIPTION CARD -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/sp_surface_soft"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/sp_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/about_dialog_description"
                android:textColor="@color/sp_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAboutVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-rounded"
                android:textColor="@color/sp_text_hint"
                android:textSize="12sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- CLOSE -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseAbout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-rounded"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/close"
        android:textAllCaps="false"
        android:textColor="@color/sp_teal_deep"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/sp_surface_soft"
        app:cornerRadius="16dp"
        app:strokeColor="@color/sp_teal"
        app:strokeWidth="1dp" />

</LinearLayout>