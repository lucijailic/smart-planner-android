<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="700dp"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">


        <!-- TITLE -->

        <TextView
            android:id="@+id/tvNotificationsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notifications_title"
            android:textColor="@color/sp_text_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- SUBTITLE -->

        <TextView
            android:id="@+id/tvNotificationsSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/notifications_subtitle"
            android:textColor="@color/sp_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNotificationsTitle" />


        <!-- LOADING -->

        <ProgressBar
            android:id="@+id/progressNotificationsLoading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="90dp"
            android:indeterminateTint="@color/sp_teal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNotificationsSubtitle" />


        <!-- FORM -->

        <LinearLayout
            android:id="@+id/layoutNotificationsForm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNotificationsSubtitle">


            <!-- ENABLE NOTIFICATIONS CARD -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/sp_border"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="92dp"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/tvNotificationsEnabled"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="14dp"
                        android:text="@string/notifications_enabled"
                        android:textColor="@color/sp_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/switchNotificationsEnabled"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvNotificationsEnabledDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="14dp"
                        android:text="@string/notifications_enabled_description"
                        android:textColor="@color/sp_text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@id/switchNotificationsEnabled"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvNotificationsEnabled" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNotificationsEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- TASK REMINDER LABEL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="9dp"
                android:text="@string/default_task_reminder"
                android:textColor="@color/sp_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- TASK REMINDER -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTaskReminder"
                style="@style/Widget.SmartPlanner.LoginInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/actTaskReminder"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:inputType="none"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- EVENT REMINDER LABEL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="9dp"
                android:text="@string/default_event_reminder"
                android:textColor="@color/sp_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- EVENT REMINDER -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEventReminder"
                style="@style/Widget.SmartPlanner.LoginInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/actEventReminder"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:inputType="none"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- SAVE BUTTON -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveNotifications"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_login_button"
                android:elevation="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/save_notification_preferences"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="20dp" />


            <!-- SAVE PROGRESS -->

            <ProgressBar
                android:id="@+id/progressSaveNotifications"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/sp_teal"
                android:visibility="gone" />

        </LinearLayout>


        <!-- ERROR STATE -->

        <LinearLayout
            android:id="@+id/layoutNotificationsError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNotificationsSubtitle">

            <TextView
                android:id="@+id/tvNotificationsError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/notification_preferences_error"
                android:textColor="@color/sp_text_secondary"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryNotifications"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:text="@string/try_again"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/sp_teal_dark"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>