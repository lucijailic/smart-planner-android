<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background"
    android:paddingStart="24dp"
    android:paddingTop="42dp"
    android:paddingEnd="24dp"
    android:paddingBottom="14dp">

    <!-- TITLE -->

    <TextView
        android:id="@+id/tvCategoriesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-rounded"
        android:text="@string/categories_title"
        android:textColor="@color/sp_text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- SUBTITLE -->

    <TextView
        android:id="@+id/tvCategoriesSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/categories_subtitle"
        android:textColor="@color/sp_text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCategoriesTitle" />

    <!-- ADD CATEGORY -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddCategory"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="19dp"
        android:background="@drawable/bg_categories_add_button"
        android:elevation="2dp"
        android:fontFamily="sans-serif-rounded"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/add_category"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="19dp"
        app:icon="@drawable/ic_category_add"
        app:iconGravity="textStart"
        app:iconPadding="9dp"
        app:iconSize="20dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCategoriesSubtitle" />

    <!-- SECTION TITLE -->

    <TextView
        android:id="@+id/tvYourCategoriesLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:fontFamily="sans-serif-rounded"
        android:letterSpacing="0.06"
        android:text="@string/your_categories"
        android:textAllCaps="true"
        android:textColor="@color/sp_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnAddCategory" />

    <!-- FIXED FOOTER -->

    <LinearLayout
        android:id="@+id/layoutCategoriesFooter"
        android:layout_width="0dp"
        android:layout_height="118dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="70dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_categories_folder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-rounded"
            android:text="@string/categories_footer_title"
            android:textColor="@color/sp_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/categories_footer_description"
            android:textColor="@color/sp_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- CATEGORIES LIST BOX -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCategoriesList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/sp_surface_soft"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/sp_border"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvYourCategoriesLabel"
        app:layout_constraintBottom_toTopOf="@id/layoutCategoriesFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- CATEGORY LIST -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCategories"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:overScrollMode="never"
                android:paddingStart="9dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:scrollbarStyle="insideInset"
                android:scrollbars="vertical"
                android:visibility="gone" />

            <!-- LOADING -->

            <ProgressBar
                android:id="@+id/progressCategories"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/sp_teal"
                android:visibility="gone" />

            <!-- EMPTY STATE -->

            <LinearLayout
                android:id="@+id/layoutCategoriesEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="54dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_categories_folder" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-rounded"
                    android:text="@string/categories_empty_title"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/categories_empty_message"
                    android:textColor="@color/sp_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ERROR STATE -->

            <LinearLayout
                android:id="@+id/layoutCategoriesError"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvCategoriesError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/categories_error"
                    android:textColor="@color/sp_text_secondary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-rounded"
                    android:text="@string/try_again"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/sp_teal_dark"
                    app:cornerRadius="15dp" />

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>