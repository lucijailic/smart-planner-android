<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <!-- ================================================= -->
        <!-- HANDLE -->
        <!-- ================================================= -->

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_bottom_sheet_handle" />

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Filters"
                android:textColor="@color/sp_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearFilters"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Clear all"
                android:textColor="@color/sp_teal_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Refine your task list"
            android:textColor="@color/sp_text_secondary"
            android:textSize="13sp" />

        <!-- ================================================= -->
        <!-- STATUS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Status"
            android:textColor="@color/sp_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipFilterStatusAny"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_task_filter_chip_selected"
                    android:gravity="center"
                    android:minWidth="58dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Any"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipFilterStatusToDo"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_task_filter_chip"
                    android:gravity="center"
                    android:minWidth="70dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="To Do"
                    android:textColor="@color/sp_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipFilterStatusInProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_task_filter_chip"
                    android:gravity="center"
                    android:minWidth="98dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="In Progress"
                    android:textColor="@color/sp_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipFilterStatusCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_task_filter_chip"
                    android:gravity="center"
                    android:minWidth="94dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Completed"
                    android:textColor="@color/sp_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- ================================================= -->
        <!-- CATEGORY -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Category"
            android:textColor="@color/sp_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutFilterCategory"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusBottomEnd="15dp"
            app:boxCornerRadiusBottomStart="15dp"
            app:boxCornerRadiusTopEnd="15dp"
            app:boxCornerRadiusTopStart="15dp"
            app:boxStrokeColor="@color/sp_border"
            app:startIconDrawable="@drawable/ic_task_category_default"
            app:startIconTint="@color/sp_text_secondary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdownFilterCategory"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:inputType="none"
                android:paddingStart="4dp"
                android:textColor="@color/sp_text_primary"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ================================================= -->
        <!-- PRIORITY -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Priority"
            android:textColor="@color/sp_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipFilterPriorityAny"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_task_filter_chip_selected"
                android:gravity="center"
                android:text="Any"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipFilterPriorityLow"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_task_filter_chip"
                android:gravity="center"
                android:text="Low"
                android:textColor="@color/sp_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipFilterPriorityMedium"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_task_filter_chip"
                android:gravity="center"
                android:text="Medium"
                android:textColor="@color/sp_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipFilterPriorityHigh"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_task_filter_chip"
                android:gravity="center"
                android:text="High"
                android:textColor="@color/sp_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ================================================= -->
        <!-- IMPORTANT -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Important"
            android:textColor="@color/sp_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipFilterImportantAny"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_task_filter_chip_selected"
                android:gravity="center"
                android:text="Any"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipFilterImportantOnly"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.25"
                android:background="@drawable/bg_task_filter_chip"
                android:gravity="center"
                android:text="★ Important"
                android:textColor="@color/sp_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipFilterImportantNot"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.35"
                android:background="@drawable/bg_task_filter_chip"
                android:gravity="center"
                android:text="Not important"
                android:textColor="@color/sp_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ================================================= -->
        <!-- DEADLINE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Deadline"
            android:textColor="@color/sp_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutFilterDate"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusBottomEnd="15dp"
            app:boxCornerRadiusBottomStart="15dp"
            app:boxCornerRadiusTopEnd="15dp"
            app:boxCornerRadiusTopStart="15dp"
            app:boxStrokeColor="@color/sp_border"
            app:startIconDrawable="@drawable/ic_task_calendar_small"
            app:startIconTint="@color/sp_text_secondary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdownFilterDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:inputType="none"
                android:paddingStart="4dp"
                android:textColor="@color/sp_text_primary"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ================================================= -->
        <!-- APPLY -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilters"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:text="Apply Filters"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/sp_teal"
            app:cornerRadius="16dp" />

    </LinearLayout>

</ScrollView>