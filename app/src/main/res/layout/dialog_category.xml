<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="26dp">

    <!-- HANDLE -->

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- TITLE -->

    <TextView
        android:id="@+id/tvCategoryDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="sans-serif-rounded"
        android:text="@string/add_category"
        android:textColor="@color/sp_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- SUBTITLE -->

    <TextView
        android:id="@+id/tvCategoryDialogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/category_dialog_subtitle"
        android:textColor="@color/sp_text_secondary"
        android:textSize="14sp" />

    <!-- NAME -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCategoryName"
        style="@style/Widget.SmartPlanner.LoginInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/category_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCategoryName"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/sp_text_primary"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- CHOOSE COLOR -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-rounded"
        android:text="@string/choose_category_color"
        android:textColor="@color/sp_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- COLORS -->

    <LinearLayout
        android:id="@+id/layoutCategoryColors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="start"
        android:orientation="horizontal">

        <View
            android:id="@+id/colorTeal"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="13dp" />

        <View
            android:id="@+id/colorBlue"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="13dp" />

        <View
            android:id="@+id/colorPurple"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="13dp" />

        <View
            android:id="@+id/colorOrange"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="13dp" />

        <View
            android:id="@+id/colorPink"
            android:layout_width="42dp"
            android:layout_height="42dp" />

    </LinearLayout>

    <!-- PREVIEW -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:fontFamily="sans-serif-rounded"
        android:text="@string/category_preview"
        android:textColor="@color/sp_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/sp_surface_soft"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/sp_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <View
                android:id="@+id/viewCategoryPreviewColor"
                android:layout_width="9dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_category_indicator" />

            <TextView
                android:id="@+id/tvCategoryPreviewName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-rounded"
                android:text="@string/category_preview_default"
                android:textColor="@color/sp_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ACTIONS -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelCategory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-rounded"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/sp_text_secondary"
            android:textStyle="bold"
            app:backgroundTint="@color/white"
            app:cornerRadius="18dp"
            app:strokeColor="@color/sp_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveCategory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1.25"
            android:fontFamily="sans-serif-rounded"
            android:text="@string/add_category"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/sp_teal"
            app:cornerRadius="18dp" />

    </LinearLayout>

</LinearLayout>