<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/sp_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sort Events"
        android:textColor="@color/sp_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="14dp"
        android:text="Choose how events should be ordered."
        android:textColor="@color/sp_text_secondary"
        android:textSize="13sp" />

    <!-- SOONEST -->

    <LinearLayout
        android:id="@+id/rowSortEventSoonest"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start date: soonest first"
            android:textColor="@color/sp_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/checkSortEventSoonest"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/sp_teal_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sp_border" />

    <!-- LATEST -->

    <LinearLayout
        android:id="@+id/rowSortEventLatest"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start date: latest first"
            android:textColor="@color/sp_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/checkSortEventLatest"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/sp_teal_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="invisible" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sp_border" />

    <!-- NEWEST -->

    <LinearLayout
        android:id="@+id/rowSortEventNewest"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Newest created"
            android:textColor="@color/sp_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/checkSortEventNewest"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/sp_teal_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="invisible" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sp_border" />

    <!-- OLDEST -->

    <LinearLayout
        android:id="@+id/rowSortEventOldest"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Oldest created"
            android:textColor="@color/sp_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/checkSortEventOldest"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/sp_teal_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="invisible" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sp_border" />

    <!-- A-Z -->

    <LinearLayout
        android:id="@+id/rowSortEventTitle"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Title: A–Z"
            android:textColor="@color/sp_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/checkSortEventTitle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/sp_teal_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="invisible" />

    </LinearLayout>

</LinearLayout>