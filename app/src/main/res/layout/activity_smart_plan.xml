<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background">


    <!-- ===================================================== -->
    <!-- FIXED HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutSmartPlanHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <TextView
            android:id="@+id/btnBackSmartPlan"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/sp_text_primary"
            android:textSize="38sp" />


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-rounded"
                android:text="Smart Plan"
                android:textColor="@color/sp_text_primary"
                android:textSize="25sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Your automatically organized work schedule"
                android:textColor="@color/sp_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- TOP CONTENT -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutSmartPlanTop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSmartPlanHeader">


        <!-- ================================================= -->
        <!-- STATUS CARD -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSmartPlanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/sp_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/sp_border"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <View
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:background="@color/sp_teal" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="17dp"
                    android:paddingTop="17dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="17dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-rounded"
                            android:text="Current plan"
                            android:textColor="@color/sp_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/tvSmartPlanStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_smart_plan_status"
                            android:paddingStart="12dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp"
                            android:text="NOT GENERATED"
                            android:textColor="@color/sp_teal_deep"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <TextView
                        android:id="@+id/tvSmartPlanPeriod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:fontFamily="sans-serif-rounded"
                        android:text="No active planning period"
                        android:textColor="@color/sp_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvSmartPlanStatusDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="1dp"
                        android:text="Generate your first Smart Plan to create a schedule for the next seven days."
                        android:textColor="@color/sp_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- PLAN INSIGHTS -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSmartPlanInsights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/sp_home_deadline_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/sp_home_deadline_icon_bg"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardBackgroundColor="@color/sp_home_deadline_icon_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:fontFamily="sans-serif-rounded"
                        android:text="!"
                        android:textColor="@color/sp_home_deadline"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:text="Plan insights"
                        android:textColor="@color/sp_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvSmartPlanInsightsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Some items need your attention"
                        android:textColor="@color/sp_text_secondary"
                        android:textSize="11sp" />

                </LinearLayout>


                <TextView
                    android:layout_width="28dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/sp_home_deadline"
                    android:textSize="25sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- ================================================= -->
        <!-- TODAY / WEEK -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutSmartPlanViewMode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_smart_plan_view_switch"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSmartPlanToday"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Today"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/sp_teal_deep"
                app:cornerRadius="14dp"
                app:elevation="0dp"
                app:strokeWidth="0dp" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSmartPlanWeek"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Week"
                android:textAllCaps="false"
                android:textColor="@color/sp_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/sp_surface_soft"
                app:cornerRadius="14dp"
                app:elevation="0dp"
                app:strokeWidth="0dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SECTION TITLE -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/tvSmartPlanSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-rounded"
                android:letterSpacing="0.07"
                android:text="TODAY'S PLAN"
                android:textColor="@color/sp_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvSmartPlanSessionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 sessions"
                android:textColor="@color/sp_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- LOADING -->
    <!-- ===================================================== -->

    <ProgressBar
        android:id="@+id/progressSmartPlan"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutSmartPlanFooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSmartPlanTop" />


    <!-- ===================================================== -->
    <!-- LIST -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSmartPlan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="11dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutSmartPlanFooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSmartPlanTop" />


    <!-- ===================================================== -->
    <!-- EMPTY -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutSmartPlanEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutSmartPlanFooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSmartPlanTop">


        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:text="✦"
            android:textColor="@color/sp_teal"
            android:textSize="38sp" />


        <TextView
            android:id="@+id/tvSmartPlanEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-rounded"
            android:gravity="center"
            android:text="No Smart Plan yet"
            android:textColor="@color/sp_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvSmartPlanEmptyDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Generate a Smart Plan to automatically organize your tasks."
            android:textColor="@color/sp_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- ERROR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutSmartPlanError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutSmartPlanFooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSmartPlanTop">


        <TextView
            android:id="@+id/tvSmartPlanError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Unable to load Smart Plan."
            android:textColor="@color/sp_text_secondary"
            android:textSize="14sp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetrySmartPlan"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="Try Again"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/sp_teal_deep"
            app:cornerRadius="14dp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- FIXED FOOTER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutSmartPlanFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/sp_background"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerateSmartPlan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Generate Smart Plan"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/sp_teal_deep"
            app:cornerRadius="17dp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>