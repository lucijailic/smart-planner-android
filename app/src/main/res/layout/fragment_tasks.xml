<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvTasksTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="36dp"
        android:text="@string/tasks_title"
        android:textColor="@color/sp_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTasksSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="1dp"
        android:text="Stay organized, get things done."
        android:textColor="@color/sp_text_secondary"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTasksTitle" />

    <!-- ===================================================== -->
    <!-- WEEK CALENDAR -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTaskCalendar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="@color/sp_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTasksSubtitle"
        app:strokeColor="@color/sp_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <!-- MONTH -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTaskCalendarMonth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnTaskCalendarPicker"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Choose date"
                    android:padding="8dp"
                    android:src="@drawable/ic_task_calendar_small"
                    app:tint="@color/sp_teal_dark" />

            </LinearLayout>

            <!-- WEEK -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPreviousTaskWeek"
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/sp_text_secondary"
                    android:textSize="28sp" />

                <LinearLayout
                    android:id="@+id/layoutTaskWeekDays"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/btnNextTaskWeek"
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/sp_text_secondary"
                    android:textSize="28sp" />

            </LinearLayout>

            <!-- SELECTED DATE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvSelectedTaskDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/sp_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvViewAllTasks"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="2dp"
                    android:text="View all"
                    android:textColor="@color/sp_teal_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ===================================================== -->
    <!-- SEARCH -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutTaskSearch"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_task_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardTaskCalendar">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Search"
            android:src="@drawable/ic_task_search"
            app:tint="@color/sp_text_secondary" />

        <EditText
            android:id="@+id/etTaskSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search tasks..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="@color/sp_text_primary"
            android:textColorHint="@color/sp_text_hint"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- QUICK STATUS FILTERS -->
    <!-- SVIH 5 STANE NA EKRAN -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/taskFilterScroll"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTaskSearch">

        <TextView
            android:id="@+id/chipAll"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="0.72"
            android:background="@drawable/bg_task_filter_chip_selected"
            android:gravity="center"
            android:text="All"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipToDo"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:layout_weight="0.94"
            android:background="@drawable/bg_task_filter_chip"
            android:gravity="center"
            android:text="To Do"
            android:textColor="@color/sp_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/chipInProgress"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1.42"
            android:background="@drawable/bg_task_filter_chip"
            android:gravity="center"
            android:maxLines="1"
            android:text="In Progress"
            android:textColor="@color/sp_text_secondary"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/chipCompleted"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1.28"
            android:background="@drawable/bg_task_filter_chip"
            android:gravity="center"
            android:maxLines="1"
            android:text="Completed"
            android:textColor="@color/sp_text_secondary"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/chipOverdue"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1.08"
            android:background="@drawable/bg_task_filter_chip"
            android:gravity="center"
            android:text="Overdue"
            android:textColor="@color/sp_text_secondary"
            android:textSize="10.5sp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- FILTER / SORT -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutTaskControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/taskFilterScroll">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdvancedFilters"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:text="Filters"
            android:textAllCaps="false"
            android:textColor="@color/sp_teal_dark"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_task_filter"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@color/sp_teal_dark"
            app:strokeColor="@color/sp_teal_dark"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSortTasks"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:text="Sort"
            android:textAllCaps="false"
            android:textColor="@color/sp_teal_dark"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_task_sort"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@color/sp_teal_dark"
            app:strokeColor="@color/sp_teal_dark"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- TASK LIST -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTasks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTaskControls" />

    <!-- ===================================================== -->
    <!-- LOADING -->
    <!-- ===================================================== -->

    <ProgressBar
        android:id="@+id/progressTasks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/sp_teal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTaskControls" />

    <!-- ===================================================== -->
    <!-- EMPTY -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutEmptyTasks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTaskControls">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:alpha="0.55"
            android:contentDescription="No tasks"
            android:src="@drawable/ic_nav_tasks"
            app:tint="@color/sp_teal_dark" />

        <TextView
            android:id="@+id/tvEmptyTasksTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="No tasks for this day"
            android:textColor="@color/sp_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyTasksMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Choose another day or add a new task."
            android:textColor="@color/sp_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- ERROR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutErrorTasks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTaskControls">

        <TextView
            android:id="@+id/tvTasksError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/sp_text_primary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryTasks"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:text="Try Again"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/sp_teal"
            app:cornerRadius="14dp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- FAB -->
    <!-- ===================================================== -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTask"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="Add task"
        android:src="@drawable/ic_task_add"
        app:backgroundTint="@color/sp_teal"
        app:borderWidth="0dp"
        app:elevation="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="24dp"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>