<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background">

    <!-- HEADER -->

    <LinearLayout
        android:id="@+id/layoutEventDetailsHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackEventDetails"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Go back"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_task_back"
            app:iconSize="22dp"
            app:iconTint="@color/sp_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Event Details"
            android:textColor="@color/sp_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- LOADING -->

    <ProgressBar
        android:id="@+id/progressEventDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/sp_teal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutEventDetailsActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutEventDetailsHeader" />

    <!-- ERROR -->

    <LinearLayout
        android:id="@+id/layoutEventDetailsError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutEventDetailsActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutEventDetailsHeader">

        <TextView
            android:id="@+id/tvEventDetailsError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Unable to load event."
            android:textColor="@color/sp_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryEventDetails"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="Try Again"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/sp_teal"
            app:cornerRadius="14dp" />

    </LinearLayout>

    <!-- CONTENT -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollEventDetails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutEventDetailsActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutEventDetailsHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- EVENT HERO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivEventDetailsCategoryIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="Event category"
                    android:padding="15dp"
                    android:src="@drawable/ic_task_category_default"
                    app:tint="@color/sp_teal_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEventDetailsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/sp_text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvEventDetailsCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:gravity="center"
                                android:paddingStart="13dp"
                                android:paddingEnd="13dp"
                                android:text="No category"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tvEventDetailsStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_task_filter_chip"
                                android:gravity="center"
                                android:paddingStart="13dp"
                                android:paddingEnd="13dp"
                                android:text="Upcoming"
                                android:textColor="@color/sp_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </HorizontalScrollView>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvEventDetailsImportant"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="☆"
                    android:textColor="@color/sp_teal_dark"
                    android:textSize="27sp" />

            </LinearLayout>

            <!-- EVENT INFORMATION -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/sp_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sp_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <!-- START -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Starts"
                            android:src="@drawable/ic_task_calendar_small"
                            app:tint="@color/sp_text_secondary" />

                        <TextView
                            android:layout_width="92dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Starts"
                            android:textColor="@color/sp_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvEventDetailsStart"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/sp_text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="34dp"
                        android:background="@color/sp_border" />

                    <!-- END -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Ends"
                            android:src="@drawable/ic_task_clock_small"
                            app:tint="@color/sp_text_secondary" />

                        <TextView
                            android:layout_width="92dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Ends"
                            android:textColor="@color/sp_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvEventDetailsEnd"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/sp_text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- LOCATION -->

                    <LinearLayout
                        android:id="@+id/layoutEventDetailsLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="34dp"
                            android:background="@color/sp_border" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Location"
                                android:src="@drawable/ic_event_location"
                                app:tint="@color/sp_text_secondary" />

                            <TextView
                                android:layout_width="92dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:text="Location"
                                android:textColor="@color/sp_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvEventDetailsLocation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/sp_text_primary"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="34dp"
                        android:background="@color/sp_border" />

                    <!-- REMINDER -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Reminder"
                            android:src="@drawable/ic_task_details_reminder"
                            app:tint="@color/sp_text_secondary" />

                        <TextView
                            android:layout_width="92dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Reminder"
                            android:textColor="@color/sp_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvEventDetailsReminder"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No reminder"
                            android:textColor="@color/sp_text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- DESCRIPTION -->

            <LinearLayout
                android:id="@+id/layoutEventDetailsDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/sp_surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sp_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Description"
                            android:textColor="@color/sp_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEventDetailsDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/sp_text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- FIXED BOTTOM ACTIONS -->

    <LinearLayout
        android:id="@+id/layoutEventDetailsActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/sp_background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- EDIT -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditEvent"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Edit Event"
            android:textAllCaps="false"
            android:textColor="@color/sp_teal_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/sp_teal_dark"
            app:strokeWidth="1dp" />

        <!-- DELETE -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteEvent"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Delete Event"
            android:textAllCaps="false"
            android:textColor="@color/sp_error"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/sp_error"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>