<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background">

    <!-- HEADER -->

    <LinearLayout
        android:id="@+id/layoutEventHeader"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackEvent"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/sp_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEventFormTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Event"
                android:textColor="@color/sp_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEventFormSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Create a new event"
                android:textColor="@color/sp_text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- FORM -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAddEditEvent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutEventHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <!-- TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Title *"
                android:textColor="@color/sp_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEventTitle"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxBackgroundColor="@color/sp_surface"
                app:boxCornerRadiusBottomEnd="13dp"
                app:boxCornerRadiusBottomStart="13dp"
                app:boxCornerRadiusTopEnd="13dp"
                app:boxCornerRadiusTopStart="13dp"
                app:boxStrokeColor="@color/sp_border_focus">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEventTitle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="textCapSentences"
                    android:maxLength="150"
                    android:singleLine="true"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CATEGORY -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Category"
                android:textColor="@color/sp_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutEventCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_task_search"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ivEventFormCategoryIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Category"
                    android:padding="2dp"
                    android:src="@drawable/ic_task_category_default"
                    app:tint="@color/sp_text_secondary"
                    android:layout_marginStart="4dp"/>

                <TextView
                    android:id="@+id/tvEventCategoryValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="No category"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Select category"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="@color/sp_text_secondary" />

            </LinearLayout>

            <!-- DESCRIPTION -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Description"
                android:textColor="@color/sp_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEventDescription"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxBackgroundColor="@color/sp_surface"
                app:boxCornerRadiusBottomEnd="13dp"
                app:boxCornerRadiusBottomStart="13dp"
                app:boxCornerRadiusTopEnd="13dp"
                app:boxCornerRadiusTopStart="13dp"
                app:boxStrokeColor="@color/sp_border_focus"
                app:counterEnabled="true"
                app:counterMaxLength="500">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEventDescription"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="500"
                    android:paddingTop="10dp"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="13sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- STARTS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Starts"
                android:textColor="@color/sp_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEventStartDate"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Select date"
                    android:textAllCaps="false"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="13dp"
                    app:icon="@drawable/ic_task_calendar_small"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="17dp"
                    app:iconTint="@color/sp_text_secondary"
                    app:strokeColor="@color/sp_border_focus"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEventStartTime"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Select time"
                    android:textAllCaps="false"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="13dp"
                    app:icon="@drawable/ic_task_clock_small"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="17dp"
                    app:iconTint="@color/sp_text_secondary"
                    app:strokeColor="@color/sp_border_focus"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- ENDS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ends"
                android:textColor="@color/sp_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEventEndDate"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Select date"
                    android:textAllCaps="false"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="13dp"
                    app:icon="@drawable/ic_task_calendar_small"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="17dp"
                    app:iconTint="@color/sp_text_secondary"
                    app:strokeColor="@color/sp_border_focus"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEventEndTime"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Select time"
                    android:textAllCaps="false"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="13dp"
                    app:icon="@drawable/ic_task_clock_small"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="17dp"
                    app:iconTint="@color/sp_text_secondary"
                    app:strokeColor="@color/sp_border_focus"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- LOCATION -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Location"
                android:textColor="@color/sp_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEventLocation"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxBackgroundColor="@color/sp_surface"
                app:boxCornerRadiusBottomEnd="13dp"
                app:boxCornerRadiusBottomStart="13dp"
                app:boxCornerRadiusTopEnd="13dp"
                app:boxCornerRadiusTopStart="13dp"
                app:boxStrokeColor="@color/sp_border_focus"
                app:startIconDrawable="@drawable/ic_event_location"
                app:startIconTint="@color/sp_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEventLocation"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="textCapWords"
                    android:singleLine="true"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="13sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- IMPORTANT -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/sp_surface"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sp_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Important event"
                            android:textColor="@color/sp_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Highlight this event as important."
                            android:textColor="@color/sp_text_secondary"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchEventImportant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- REMINDER -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Reminder"
                android:textColor="@color/sp_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEventReminder"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxBackgroundColor="@color/sp_surface"
                app:boxCornerRadiusBottomEnd="13dp"
                app:boxCornerRadiusBottomStart="13dp"
                app:boxCornerRadiusTopEnd="13dp"
                app:boxCornerRadiusTopStart="13dp"
                app:boxStrokeColor="@color/sp_border_focus"
                app:startIconDrawable="@drawable/ic_task_details_reminder"
                app:startIconTint="@color/sp_text_secondary">

                <AutoCompleteTextView
                    android:id="@+id/actEventReminder"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="none"
                    android:singleLine="true"
                    android:textColor="@color/sp_text_primary"
                    android:textSize="13sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- PROGRESS -->

            <ProgressBar
                android:id="@+id/progressSaveEvent"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp"
                android:indeterminateTint="@color/sp_teal"
                android:visibility="gone" />

            <!-- SAVE -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveEvent"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="Create Event"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/sp_teal"
                app:cornerRadius="15dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>